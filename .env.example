# 复制为 .env 后按需修改。.env 不会被提交。
# 生产环境请改用 systemd EnvironmentFile 或容器密钥，不要依赖项目目录下的 .env。

# ── 服务端（读取时机：进程启动） ──────────────────────────────

# 会话签名密钥。开发环境留空会自动生成并写入 server/data/.session-secret；
# 生产环境必须显式提供 ≥32 位随机串，缺失将拒绝启动。
SESSION_SECRET=

# 首次建库时的管理员初始密码。留空则随机生成并打印到启动日志。
INITIAL_ADMIN_PASSWORD=

# 监听端口，默认 3001。生产模式下该端口同时提供 dist 静态文件与 /api。
PORT=3001

# SQLite 数据库文件路径，默认 server/data/family.db
DATABASE_FILE=

# 会话 Cookie 名，默认 fg_session
SESSION_COOKIE_NAME=

# 证书管理脚本回写 TLS 状态用的共享令牌。留空则该组接口一律 403。
INTERNAL_API_TOKEN=

# ── 前端（读取时机：npm run dev / npm run build） ─────────────
# VITE_ 前缀的变量会被打进前端产物，只能放公开值，不要写密钥。

# 访问统计站点标识。留空则不加载任何第三方统计脚本。
VITE_BAIDU_ANALYTICS_ID=
